    {
      "parameters": {
        "jsCode": "// Verifica se o novo horario colide com algum agendamento ja confirmado DO MESMO colaborador\n// (agenda por profissional: dois clientes podem marcar o mesmo horario com pessoas diferentes)\n// ou com um bloqueio de agenda criado pelo admin (folga/ferias/etc) para o mesmo colaborador/data.\n// As duas queries ao Supabase ja filtraram por colaborador+empresa; aqui filtra por data+status e calcula a sobreposicao.\nconst novo = $('Aplicar Preco Do Catalogo').first().json;\n\nconst toMinutos = (hhmm) => {\n  const [h, m] = String(hhmm).split(':').map(Number);\n  return h * 60 + m;\n};\n\nconst inicioNovo = toMinutos(novo.hora);\nconst fimNovo = inicioNovo + novo.duracao_minutos;\n\nconst existentes = $('Ler Agendamentos Existentes (Supabase)').all()\n  .map(i => i.json)\n  .filter(row => row && row.hora && row.data === novo.data && row.status !== 'Cancelado');\n\nconst conflitoAgendamento = existentes.some(row => {\n  const inicio = toMinutos(row.hora);\n  const fim = inicio + (Number(row.duracao_minutos) || 30);\n  return inicio < fimNovo && fim > inicioNovo;\n});\n\nconst bloqueios = $('Ler Bloqueios Ativos (Supabase)').all()\n  .map(i => i.json)\n  .filter(row => row && row.data === novo.data && row.status === 'Ativo');\n\nconst bloqueioDiaInteiro = bloqueios.some(b => !b.hora_inicio && !b.hora_fim);\n\nconst conflitoBloqueio = bloqueioDiaInteiro || bloqueios.some(b => {\n  if (!b.hora_inicio || !b.hora_fim) return false;\n  const inicio = toMinutos(b.hora_inicio);\n  const fim = toMinutos(b.hora_fim);\n  return inicio < fimNovo && fim > inicioNovo;\n});\n\nreturn [{ json: { ...novo, conflito: conflitoAgendamento || conflitoBloqueio } }];"
      },
