    {
      "parameters": {
        "jsCode": "// A query ao Supabase ja filtrou por nome+empresa; aqui confirma que esta ativo e trava preco/duracao no catalogo\nconst novo = $('Validar Dados').first().json;\nconst encontrados = $input.all().map(i => i.json).filter(row => row && row.nome === novo.servico && row.ativo === true);\n\nif (encontrados.length === 0) {\n  return [{\n    json: {\n      valido: false,\n      encontrado: false,\n      erro: 'Servico nao encontrado ou inativo: ' + novo.servico\n    }\n  }];\n}\n\nconst servico = encontrados[0];\n\nreturn [{\n  json: {\n    ...novo,\n    encontrado: true,\n    preco: Number(servico.preco) || 0,\n    duracao_minutos: Number(servico.duracao_minutos) || 30\n  }\n}];"
      },
