    {
      "parameters": {
        "jsCode": "// Valida o payload recebido do app do cliente\nconst body = $('Webhook').first().json.body || {};\nconst cliente = body.cliente || {};\nconst ag = body.agendamento || {};\n\nconst erros = [];\nif (!cliente.nome || !String(cliente.nome).trim()) erros.push('nome');\nif (!cliente.whatsapp || !/^\\d{10,13}$/.test(String(cliente.whatsapp).replace(/\\D/g, ''))) erros.push('whatsapp');\nif (!ag.servico) erros.push('servico');\nif (!ag.colaborador || !String(ag.colaborador).trim()) erros.push('colaborador');\nif (!ag.data || !/^\\d{4}-\\d{2}-\\d{2}$/.test(ag.data)) erros.push('data');\nif (!ag.hora || !/^\\d{2}:\\d{2}$/.test(ag.hora)) erros.push('hora');\n\nif (erros.length) {\n  return [{\n    json: {\n      valido: false,\n      status: 400,\n      erro: 'Campos invalidos ou ausentes: ' + erros.join(', ')\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valido: true,\n    empresa_id: $('Checar Empresa').first().json.empresa_id,\n    id: 'AG-' + Date.now(),\n    nome: String(cliente.nome).trim(),\n    whatsapp: String(cliente.whatsapp).replace(/\\D/g, ''),\n    servico: ag.servico,\n    preco: Number(ag.preco) || 0,\n    duracao_minutos: Number(ag.duracao_minutos) || 30,\n    colaborador: String(ag.colaborador).trim(),\n    data: ag.data,\n    hora: ag.hora,\n    status: 'Confirmado',\n    criado_em: new Date().toISOString(),\n    lembrete_enviado: false\n  }\n}];"
      },
