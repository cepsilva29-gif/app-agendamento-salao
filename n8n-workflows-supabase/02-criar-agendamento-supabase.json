      "id": "91e14232-2a8b-4d90-8a93-3393523def45",
      "name": "Ler Bloqueios Ativos (Supabase)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        224,
        336
