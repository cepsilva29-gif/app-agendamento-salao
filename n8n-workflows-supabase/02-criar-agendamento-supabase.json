      "parameters": {
        "jsCode": "const encontradas = $input.all().map(i => i.json).filter(row => row && row.id);\nif (encontradas.length === 0) return [{ json: { encontrada: false } }];\nconst e = encontradas[0];\nreturn [{ json: { encontrada: true, empresa_id: e.id, evolution_instance: e.evolution_instance, nome: e.nome, whatsapp_admin: e.whatsapp_admin } }];"
      },
