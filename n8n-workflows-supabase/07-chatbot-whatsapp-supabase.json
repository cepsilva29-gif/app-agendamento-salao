    },
    {
      "parameters": {
        "jsCode": "// Opcao 3: mostra os agendamentos ativos (Confirmado ou Finalizado) do numero que esta escrevendo\n// A query ao Supabase ja filtrou por status!=Cancelado+empresa; aqui so localiza pelo numero de quem escreveu\nconst numeroCliente = $('Extrair Mensagem').first().json.numero;\nconst linhas = $input.all().map(i => i.json);\n\nfunction normaliza(tel) {\n  return String(tel || '').replace(/\\D/g, '').slice(-11);\n}\n\nconst alvo = normaliza(numeroCliente);\nconst agendamentos = linhas\n  .filter(r => r && normaliza(r.whatsapp) === alvo)\n  .sort((a, b) => String(a.data + a.hora).localeCompare(String(b.data + b.hora)));\n\nif (agendamentos.length === 0) {\n  return [{ json: { numero: numeroCliente, resposta: 'Você não tem nenhum agendamento ativo no momento.\\n\\nDigite *1* para agendar um horário.' } }];\n}\n\nconst lista = agendamentos\n  .map(r => `💈 ${r.servico}\\n📅 ${r.data} às ${r.hora}\\n👤 ${r.colaborador || '-'}\\n📌 Status: ${r.status}`)\n  .join('\\n\\n');\n\nreturn [{ json: { numero: numeroCliente, resposta: 'Seus agendamentos:\\n\\n' + lista } }];"
      },
      "id": "s07-code-status",
      "name": "Buscar Status do Cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $('Extrair Mensagem').first().json.instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": $json.numero, \"text\": $json.resposta } }}",
        "options": {}
      },
