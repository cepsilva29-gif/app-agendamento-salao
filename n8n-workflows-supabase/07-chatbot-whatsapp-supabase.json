    {
      "parameters": {
        "jsCode": "// Extrai texto, remetente e a instancia Evolution (= a empresa que recebeu a mensagem) do payload\n// de evento 'messages.upsert' da Evolution API. Multi-tenant: cada empresa tem sua propria instancia,\n// e o payload sempre informa qual instancia recebeu o evento.\nconst body = $input.first().json.body || {};\nconst data = body.data || {};\nconst fromMe = !!(data.key && data.key.fromMe);\nconst remoteJid = (data.key && data.key.remoteJid) || '';\nconst numero = remoteJid.split('@')[0];\nconst msg = data.message || {};\nconst textoOriginal = msg.conversation || (msg.extendedTextMessage && msg.extendedTextMessage.text) || '';\n\nreturn [{\n  json: {\n    fromMe,\n    numero,\n    instance: body.instance || '',\n    texto: String(textoOriginal).trim().toUpperCase()\n  }\n}];"
      },
      "id": "s07-code-extrair",
      "name": "Extrair Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
