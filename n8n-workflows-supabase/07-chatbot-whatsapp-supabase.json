    {
      "parameters": {
        "jsCode": "// Opcao 1: reenvia o link do app para agendar (cada empresa tem seu proprio subdominio de agenda)\nconst dominio = $env.DOMAIN || 'suaempresa.com.br';\nconst slug = $('Checar Empresa').first().json.slug;\nconst resposta = 'Para agendar, acesse: https://agenda-' + slug + '.' + dominio + '\\nEscolha o serviço, o colaborador, a data e o horário direto por lá! 💈';\nreturn [{ json: { numero: $('Extrair Mensagem').first().json.numero, resposta } }];"
      },
      "id": "s07-code-resposta-agendar",
      "name": "Montar Resposta Agendar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Nenhuma opcao reconhecida (primeiro contato ou mensagem fora do menu): mostra o menu numerado\nconst nomeEmpresa = $('Checar Empresa').first().json.nome || 'nossa empresa';\nconst resposta = 'Olá! 👋 Sou o assistente virtual do ' + nomeEmpresa + '.\\n\\nEscolha uma opção e responda só com o número:\\n\\n*1* - Agendar um horário\\n*2* - Cancelar um agendamento\\n*3* - Ver o status do meu agendamento';\nreturn [{ json: { numero: $('Extrair Mensagem').first().json.numero, resposta } }];"
      },
      "id": "s07-code-resposta-menu",
      "name": "Montar Resposta Menu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        500
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "agendamentos",
        "returnAll": true,
        "filterType": "manual",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "Confirmado"
            },
            {
              "keyName": "empresa_id",
              "condition": "eq",
              "keyValue": "={{ $('Checar Empresa').first().json.empresa_id }}"
            }
          ]
        },
        "matchType": "allFilters"
      },
      "id": "s07-supabase-agendamentos",
      "name": "Ler Agendamentos (Supabase)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1760,
        260
      ],
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "PLACEHOLDER_SUPABASE_CREDENTIAL",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// A query ao Supabase ja filtrou por status=Confirmado+empresa; aqui so localiza pelo numero de quem escreveu\nconst numeroCliente = $('Extrair Mensagem').first().json.numero;\nconst linhas = $input.all().map(i => i.json);\n\nfunction normaliza(tel) {\n  return String(tel || '').replace(/\\D/g, '').slice(-11);\n}\n\nconst alvo = normaliza(numeroCliente);\nconst confirmados = linhas.filter(r => normaliza(r.whatsapp) === alvo);\n\nif (confirmados.length === 0) {\n  return [{ json: { encontrado: false, motivo: 'nenhum', numero: numeroCliente } }];\n}\n\nif (confirmados.length > 1) {\n  const lista = confirmados\n    .sort((a, b) => String(a.data + a.hora).localeCompare(String(b.data + b.hora)))\n    .map(r => `- ${r.servico} em ${r.data} às ${r.hora}`)\n    .join('\\n');\n  return [{ json: { encontrado: false, motivo: 'multiplos', numero: numeroCliente, lista } }];\n}\n\nreturn [{ json: { ...confirmados[0], encontrado: true } }];"
      },
      "id": "s07-code-localizar",
      "name": "Localizar Agendamento do Cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        260
      ]
    },
    {
