            {
              "keyName": "evolution_instance",
              "condition": "eq",
              "keyValue": "={{ $json.instance }}"
            },
            {
              "keyName": "ativo",
              "condition": "eq",
              "keyValue": "true"
            }
          ]
        },
        "matchType": "allFilters"
      },
