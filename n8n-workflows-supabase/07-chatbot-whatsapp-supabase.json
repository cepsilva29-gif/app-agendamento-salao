    {
      "parameters": {
        "jsCode": "// Confirma para o cliente que o cancelamento foi feito\nconst r = $('Localizar Agendamento do Cliente').item.json;\nconst resposta = `Pronto, ${r.nome}! Seu agendamento de ${r.servico} no dia ${r.data} às ${r.hora} foi cancelado. Se quiser reagendar, é só acessar o app da empresa.`;\nreturn [{ json: { numero: r.whatsapp, resposta } }];"
      },
      "id": "s07-code-resposta-ok",
      "name": "Montar Resposta Cancelamento OK",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "// Nao achou nenhum agendamento confirmado, ou achou mais de um -> pede para o cliente esclarecer\nconst dominio = $env.DOMAIN || 'suaempresa.com.br';\nconst slug = $('Checar Empresa').first().json.slug;\nlet resposta;\n\nif ($json.motivo === 'multiplos') {\n  resposta = 'Você tem mais de um agendamento confirmado:\\n' + $json.lista + '\\n\\nAcesse https://agenda-' + slug + '.' + dominio + ' ou fale com a gente informando qual horário deseja cancelar.';\n} else {\n  resposta = 'Não encontrei nenhum agendamento confirmado com este número. Se preferir, acesse https://agenda-' + slug + '.' + dominio + ' para conferir seus horários.';\n}\n\nreturn [{ json: { numero: $json.numero, resposta } }];"
      },
      "id": "s07-code-resposta-nao-encontrado",
      "name": "Montar Resposta Nao Encontrado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
