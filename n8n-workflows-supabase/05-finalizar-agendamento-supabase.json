        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": $('Localizar e Atualizar Status').item.json.whatsapp, \"text\": \"Obrigado por vir ao \" + $env.SALON_NAME + \", \" + $('Localizar e Atualizar Status').item.json.nome + \"! Esperamos que tenha gostado do(a) \" + $('Localizar e Atualizar Status').item.json.servico + \". Até a próxima! 💈\" } }}",
        "options": {}
