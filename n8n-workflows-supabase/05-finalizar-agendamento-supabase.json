        "jsCode": "const encontrados = $input.all().map(i => i.json).filter(row => row && row.id);\n\nif (encontrados.length === 0) {\n  return [{ json: { encontrado: false } }];\n}\n\nreturn [{ json: { ...encontrados[0], encontrado: true } }];"
      },
