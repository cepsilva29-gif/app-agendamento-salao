    {
      "parameters": {
        "jsCode": "// Valida o payload recebido do painel admin (atualizacao completa da linha)\nconst body = $('Webhook Atualizar').first().json.body || {};\n\nconst erros = [];\nif (!body.id) erros.push('id');\nif (!body.nome || !String(body.nome).trim()) erros.push('nome');\nconst preco = Number(body.preco);\nif (!isFinite(preco) || preco <= 0) erros.push('preco');\nconst duracao = Number(body.duracao_minutos);\nif (!isFinite(duracao) || duracao <= 0) erros.push('duracao_minutos');\n\nif (erros.length) {\n  return [{ json: { valido: false, erro: 'Campos invalidos ou ausentes: ' + erros.join(', ') } }];\n}\n\nreturn [{\n  json: {\n    valido: true,\n    id: body.id,\n    nome: String(body.nome).trim(),\n    preco,\n    duracao_minutos: duracao,\n    ativo: body.ativo !== false\n  }\n}];"
      },
