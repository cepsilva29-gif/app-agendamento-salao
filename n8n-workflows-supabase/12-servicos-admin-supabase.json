    {
      "parameters": {
        "jsCode": "const servicos = $input.all()\n  .map(i => i.json)\n  .filter(row => row && row.id)\n  .map(row => ({\n    id: row.id,\n    nome: row.nome,\n    preco: Number(row.preco) || 0,\n    duracao_minutos: Number(row.duracao_minutos) || 30,\n    ativo: !!row.ativo\n  }));\nreturn [{ json: { servicos } }];"
      },
