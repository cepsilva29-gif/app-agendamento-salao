{
  "name": "00 - Listar Serviços (Supabase)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "servicos",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "s00-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        40,
        300
      ],
      "webhookId": "servicos-get-0001-supabase"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": {
          "__rl": true,
          "value": "empresas",
          "mode": "id"
        },
        "returnAll": true,
        "filterType": "manual",
        "filters": {
          "conditions": [
            {
              "keyName": "slug",
              "condition": "eq",
              "keyValue": "={{ $json.query.slug }}"
            },
            {
              "keyName": "ativo",
              "condition": "eq",
              "keyValue": "true"
            }
          ]
        },
        "matchType": "allFilters"
      },
      "id": "s00-resolver-empresa",
      "name": "Resolver Empresa",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "PLACEHOLDER_SUPABASE_CREDENTIAL",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// A query ja filtrou por slug+ativo; aqui so confirma que achou a empresa.\nconst encontradas = $input.all().map(i => i.json).filter(row => row && row.id);\nif (encontradas.length === 0) return [{ json: { encontrada: false } }];\nreturn [{ json: { encontrada: true, empresa_id: encontradas[0].id } }];"
      },
      "id": "s00-checar-empresa",
      "name": "Checar Empresa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.encontrada }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "s00-empresa-if",
      "name": "Empresa Encontrada?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": {
          "__rl": true,
          "value": "servicos",
          "mode": "id"
        },
        "returnAll": true,
        "filterType": "manual",
        "filters": {
          "conditions": [
            {
              "keyName": "ativo",
              "condition": "eq",
              "keyValue": "true"
            },
            {
              "keyName": "empresa_id",
              "condition": "eq",
              "keyValue": "={{ $json.empresa_id }}"
            }
          ]
        },
        "matchType": "allFilters"
      },
      "id": "s00-supabase-getall",
      "name": "Ler Servicos (Supabase)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        900,
        220
      ],
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "PLACEHOLDER_SUPABASE_CREDENTIAL",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Filtro de ativo/empresa ja aconteceu na query ao Supabase; aqui so formata para o app do cliente.\n// O no Supabase tem alwaysOutputData=true (necessario para o workflow continuar mesmo com 0\n// resultados), entao filtra o item vazio de placeholder que ele emite quando nao ha linhas.\nconst servicos = $input.all()\n  .map(item => item.json)\n  .filter(row => row && row.nome)\n  .map(row => ({\n    nome: row.nome,\n    preco: Number(row.preco) || 0,\n    duracao_minutos: Number(row.duracao_minutos) || 30\n  }));\n\nreturn [{ json: { servicos } }];"
      },
      "id": "s00-code-formatar",
      "name": "Formatar Servicos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        220
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "s00-respond",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1340,
        220
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"sucesso\": false, \"mensagem\": \"Empresa nao encontrada.\" } }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          },
          "responseCode": 404
        }
      },
      "id": "s00-respond-404",
      "name": "Responder Empresa Nao Encontrada",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        900,
        420
      ]
    }
  ],
  "connections": {
