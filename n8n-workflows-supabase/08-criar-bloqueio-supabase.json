    {
      "parameters": {
        "jsCode": "// Valida o payload recebido do painel admin\nconst body = $('Webhook').first().json.body || {};\n\nconst erros = [];\nif (!body.cabeleireiro || !String(body.cabeleireiro).trim()) erros.push('cabeleireiro');\nif (!body.data || !/^\\d{4}-\\d{2}-\\d{2}$/.test(body.data)) erros.push('data');\n\nconst diaInteiro = !body.hora_inicio && !body.hora_fim;\nif (!diaInteiro) {\n  if (!body.hora_inicio || !/^\\d{2}:\\d{2}$/.test(body.hora_inicio)) erros.push('hora_inicio');\n  if (!body.hora_fim || !/^\\d{2}:\\d{2}$/.test(body.hora_fim)) erros.push('hora_fim');\n  if (!erros.includes('hora_inicio') && !erros.includes('hora_fim') && body.hora_inicio >= body.hora_fim) {\n    erros.push('hora_fim deve ser depois de hora_inicio');\n  }\n}\n\nif (erros.length) {\n  return [{\n    json: {\n      valido: false,\n      erro: 'Campos invalidos ou ausentes: ' + erros.join(', ')\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valido: true,\n    id: 'BQ-' + Date.now(),\n    cabeleireiro: String(body.cabeleireiro).trim(),\n    data: body.data,\n    hora_inicio: diaInteiro ? null : body.hora_inicio,\n    hora_fim: diaInteiro ? null : body.hora_fim,\n    motivo: body.motivo ? String(body.motivo).trim() : '',\n    status: 'Ativo',\n    criado_em: new Date().toISOString()\n  }\n}];"
      },
