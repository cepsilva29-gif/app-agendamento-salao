    {
      "parameters": {
        "jsCode": "// Resolve \"hoje\" antes de consultar o Supabase, ja que o filtro precisa ser calculado antes do nó de leitura.\n// O sandbox do Code node roda em UTC; America/Sao_Paulo = UTC-3 fixo, conversao manual.\nconst hoje = new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10); // AAAA-MM-DD\nreturn [{ json: { hoje } }];"
      },
      "id": "d32bf076-4f3a-494e-bc48-3ad94207ad22",
      "name": "Calcular Data Hoje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -608,
        -240
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/bloqueios",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ $('Webhook').first().json.headers.authorization }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "eq.Ativo"
            },
            {
              "name": "select",
              "value": "*"
            }
          ]
        },
        "options": {}
      },
      "id": "e77f5f5e-c7be-4365-95bf-b84349d4f6b1",
      "name": "Ler Bloqueios (PostgREST)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -384,
        -240
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// A query ja filtrou por status=Ativo (e pela empresa, via RLS); aqui filtra data>=hoje, ordena e formata para o painel admin.\nconst hoje = $('Calcular Data Hoje').first().json.hoje;\nconst bloqueios = $input.all()\n  .map(item => item.json)\n  .filter(row => row && row.id && row.data >= hoje)\n  .sort((a, b) => (a.data + (a.hora_inicio || '00:00')).localeCompare(b.data + (b.hora_inicio || '00:00')))\n  .map(row => ({\n    id: row.id,\n    cabeleireiro: row.cabeleireiro,\n    data: row.data,\n    hora_inicio: row.hora_inicio || null,\n    hora_fim: row.hora_fim || null,\n    dia_inteiro: !row.hora_inicio && !row.hora_fim,\n    motivo: row.motivo || ''\n  }));\n\nreturn [{ json: { bloqueios } }];"
      },
      "id": "59c37c00-32c7-43b7-b454-7d3ef3d9f141",
      "name": "Formatar Bloqueios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
