    {
      "parameters": {
        "jsCode": "// Resolve a data-filtro (default: hoje) antes de consultar o Supabase, ja que o filtro precisa\n// ser calculado antes do nó de leitura.\nconst query = $('Webhook').first().json.query || {};\n// O sandbox do Code node roda em UTC; America/Sao_Paulo = UTC-3 fixo, conversao manual.\nconst hoje = new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10); // AAAA-MM-DD\nconst dataFiltro = query.data || hoje;\n\nreturn [{ json: { dataFiltro } }];"
      },
      "id": "0db5b1ba-deb6-43e3-855c-17c645690747",
      "name": "Calcular Data Filtro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -608,
        -240
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/agendamentos",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ $('Webhook').first().json.headers.authorization }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "data",
              "value": "=eq.{{ $json.dataFiltro }}"
            },
            {
              "name": "select",
              "value": "*"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a6d3d0-729a-4d0d-87db-6cef9503c29d",
      "name": "Ler Agendamentos (PostgREST)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -384,
        -240
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// A query ao Supabase ja filtrou pela data (e pela empresa, via RLS); aqui so ordena e monta o resumo do dashboard\nconst dataFiltro = $('Calcular Data Filtro').first().json.dataFiltro;\n\nconst doDia = $input.all()\n  .map(i => i.json)\n  .filter(r => r && r.hora)\n  .sort((a, b) => a.hora.localeCompare(b.hora));\n\nconst confirmados = doDia.filter(r => r.status === 'Confirmado');\nconst finalizados = doDia.filter(r => r.status === 'Finalizado');\nconst faturamentoEstimado = [...confirmados, ...finalizados]\n  .reduce((soma, r) => soma + (Number(r.preco) || 0), 0);\n\nreturn [{\n  json: {\n    data: dataFiltro,\n    resumo: {\n      total_agendamentos: doDia.filter(r => r.status !== 'Cancelado').length,\n      faturamento_estimado: Number(faturamentoEstimado.toFixed(2)),\n      cancelados: doDia.filter(r => r.status === 'Cancelado').length\n    },\n    agendamentos: doDia.map(r => ({\n      id: r.id,\n      hora: r.hora,\n      nome: r.nome,\n      whatsapp: r.whatsapp,\n      servico: r.servico,\n      cabeleireiro: r.cabeleireiro || '',\n      preco: Number(r.preco) || 0,\n      status: r.status\n    }))\n  }\n}];"
      },
      "id": "de2cba16-239f-406a-b035-ea77e1ea2f84",
