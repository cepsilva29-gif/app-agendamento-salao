    {
      "parameters": {
        "jsCode": "// Evolution API: GET /instance/connectionState/<nome> devolve { instance: { state: 'open'|'connecting'|'close' } }\n// quando a instancia existe; devolve erro (404) quando ainda nao foi criada (empresa nunca conectou).\nconst j = $input.first().json;\nif (!j || j.error) return [{ json: { status: 'nao_criada' } }];\nconst state = j.instance && j.instance.state;\nif (state === 'open') return [{ json: { status: 'conectado' } }];\nif (state === 'connecting') return [{ json: { status: 'conectando' } }];\nreturn [{ json: { status: 'nao_criada' } }];"
      },
