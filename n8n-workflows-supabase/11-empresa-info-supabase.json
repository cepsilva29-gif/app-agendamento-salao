    {
      "parameters": {
        "jsCode": "// Valida o payload: espera { colaboradores: [\"Carlos\", \"Ana\", ...] }\nconst body = $('Webhook Atualizar Colaboradores').first().json.body || {};\nconst lista = body.colaboradores;\n\nif (!Array.isArray(lista) || !lista.every(n => typeof n === 'string')) {\n  return [{ json: { valido: false, erro: 'colaboradores deve ser uma lista de nomes (texto)' } }];\n}\n\nconst limpos = lista.map(n => n.trim()).filter(Boolean);\n\nreturn [{ json: { valido: true, colaboradores: limpos } }];"
      },
