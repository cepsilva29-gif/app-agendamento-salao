    {
      "parameters": {
        "jsCode": "const encontradas = $input.all().map(i => i.json).filter(row => row && row.id);\nif (encontradas.length === 0) return [{ json: { encontrada: false } }];\nconst e = encontradas[0];\nreturn [{ json: { encontrada: true, nome: e.nome, colaboradores: e.colaboradores || [] } }];"
      },
