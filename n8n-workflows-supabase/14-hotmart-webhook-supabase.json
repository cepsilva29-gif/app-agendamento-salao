    {
      "parameters": {
        "jsCode": "const acao = $('Determinar Acao').first().json.acao;\nconst encontradas = $input.all().map(i => i.json).filter(row => row && row.id);\n\nif (encontradas.length === 0) {\n  return [{ json: { encontrada: false, acao } }];\n}\n\nreturn [{ json: { encontrada: true, acao, empresa_id: encontradas[0].id } }];"
      },
