{
  "name": "14 - Webhook Hotmart (Supabase)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hotmart-webhook",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "s14-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1200,
        300
      ],
      "webhookId": "hotmart-webhook-post-0001-supabase"
    },
    {
      "parameters": {
        "jsCode": "// Valida a notificacao da Hotmart e extrai os campos que interessam.\n//\n// O Hottok (token de validacao) pode vir no corpo (campo \"hottok\") ou no header\n// X-Hotmart-Hottok dependendo da versao/config do webhook na conta Hotmart -- checa os dois.\n// NAO confirmado ainda contra um envio real: use o botao \"Enviar teste\" no painel da Hotmart\n// (Ferramentas > Webhook) e confira a execucao deste workflow no n8n pra ver qual dos dois\n// formatos a sua conta usa; ajuste aqui se o campo vier em outro lugar.\n//\n// Payload esperado (webhook v2.0.0 da Hotmart): { event, data: { product: { id }, buyer: { email }, purchase: { transaction, status } } }\nconst body = $json.body || {};\nconst headers = $json.headers || {};\n\nconst hottokRecebido = body.hottok || headers['x-hotmart-hottok'] || '';\nconst autorizado = !!$env.HOTMART_HOTTOK && hottokRecebido === $env.HOTMART_HOTTOK;\n\nconst produto = (body.data && body.data.product) || {};\n// HOTMART_PRODUCT_ID vazio = nao filtra por produto (use se este webhook so recebe eventos do app_agendamento).\nconst produtoCorresponde = !$env.HOTMART_PRODUCT_ID || String(produto.id || '') === String($env.HOTMART_PRODUCT_ID);\n\nconst buyer = (body.data && body.data.buyer) || {};\nconst purchase = (body.data && body.data.purchase) || {};\n\nreturn [{\n  json: {\n    autorizado,\n    produtoCorresponde,\n    event: body.event || '',\n    email: String(buyer.email || '').trim().toLowerCase(),\n    transacao: purchase.transaction || ''\n  }\n}];"
      },
      "id": "s14-validar",
      "name": "Validar Requisicao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.autorizado }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
