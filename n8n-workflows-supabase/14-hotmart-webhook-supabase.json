    {
      "parameters": {
        "jsCode": "// Traduz o evento da Hotmart numa acao sobre empresas.ativo.\nconst evento = $json.event;\nconst desativar = ['PURCHASE_CANCELED', 'PURCHASE_REFUNDED', 'PURCHASE_CHARGEBACK'].includes(evento);\nconst reativar = ['PURCHASE_APPROVED', 'PURCHASE_COMPLETE'].includes(evento);\n\nreturn [{ json: { ...$json, acao: desativar ? 'desativar' : (reativar ? 'reativar' : 'ignorar') } }];"
      },
      "id": "s14-determinar-acao",
      "name": "Determinar Acao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.acao }}",
              "rightValue": "ignorar",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "s14-acao-relevante-if",
