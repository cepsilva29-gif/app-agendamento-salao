# easypanel/app_agendamento.env.example
#
# Variaveis usadas pelo servico Compose (easypanel/docker-compose.easypanel.yml) dentro do
# projeto "app_agendamento" no Easypanel. Copie este arquivo para "easypanel/app_agendamento.env"
# (gitignored) e preencha com os valores reais, ou cole direto na tela de variaveis de ambiente
# do servico no painel do Easypanel — nao existe ".env" versionado em producao.
# Veja docs/deploy-easypanel.md para o passo a passo completo.

# ---- Dominio ----
DOMAIN=

# ---- n8n ----
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
TIMEZONE=America/Sao_Paulo
N8N_DB_PASSWORD=

# ---- Evolution API (WhatsApp) ----
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_DB_PASSWORD=

# Numero do WhatsApp do dono do salao (com DDI+DDD, so numeros), recebe notificacao de todo
# novo agendamento e e usado como remetente das mensagens automaticas.
SALON_ADMIN_WHATSAPP=
SALON_NAME=

# ---- Supabase ----
# Nao e lido por $env.* dentro dos workflows (o no nativo Supabase do n8n autentica por
# credencial propria, cadastrada na UI do n8n) — guarde aqui so como referencia para o passo
# "Criar a credencial Supabase no n8n" do docs/deploy-easypanel.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Hotmart (workflow 14, webhook /hotmart-webhook) ----
# Token de validacao mostrado no painel da Hotmart em Ferramentas > Webhook, para o produto
# app_agendamento. HOTMART_PRODUCT_ID filtra esse produto entre outros da mesma conta Hotmart
# (deixe vazio pra nao filtrar).
HOTMART_HOTTOK=
HOTMART_PRODUCT_ID=
