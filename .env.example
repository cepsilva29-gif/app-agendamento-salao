# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" (com valores reais) para o git ou para qualquer lugar público.

# ---- Domínio ----
# Domínio principal apontado (registros A) para o IP da VPS Hostinger KVM2.
DOMAIN=engenhariadedadosn8n.shop

# ---- n8n ----
N8N_ENCRYPTION_KEY=troque_por_uma_string_aleatoria_longa
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque_por_uma_senha_forte
TIMEZONE=America/Sao_Paulo

# Postgres usado pelo n8n para guardar credenciais/execuções (não é o "banco" do app,
# o banco de dados do agendamento em si é o Google Sheets).
N8N_DB_PASSWORD=troque_por_uma_senha_forte_2

# ---- Evolution API (WhatsApp) ----
EVOLUTION_API_KEY=troque_por_uma_chave_aleatoria_longa
EVOLUTION_INSTANCE=salao
EVOLUTION_DB_PASSWORD=troque_por_uma_senha_forte_3

# Número do WhatsApp do dono do salão (com DDI+DDD, só números), recebe notificação
# de todo novo agendamento e é usado como remetente das mensagens automáticas.
SALON_ADMIN_WHATSAPP=5511999998888
SALON_NAME=Salão Elegance

# ---- Google Sheets ----
# ID da planilha (trecho da URL entre /d/ e /edit). Veja docs/google-sheets-schema.md
GOOGLE_SHEET_ID=cole_o_id_da_planilha_aqui

# ---- Supabase (trilha multi-tenant, n8n-workflows-supabase/) ----
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=cole_a_anon_key_aqui

# ---- Hotmart (workflow 14, webhook /hotmart-webhook) ----
# Token de validacao mostrado no painel da Hotmart em Ferramentas > Webhook, para o produto
# app_agendamento. HOTMART_PRODUCT_ID filtra esse produto entre outros da mesma conta Hotmart
# (deixe vazio pra nao filtrar).
HOTMART_HOTTOK=cole_o_hottok_aqui
HOTMART_PRODUCT_ID=
